{
  "manifest_version": 2,
  "name": "YouTube Music Visualizer",
  "version": "1.0",
  "description": "Adds a music visualizer overlay to YouTube videos.",
  "permissions": ["tabs", "activeTab"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["visualizer.css"]
    }
  ],
  "icons": {
    "48": "icons/icon48.png"
  }
}
