{
  "manifest_version": 2,
  "name": "YouTube Music Visualizer",
  "version": "1.0.0",
  "description": "A beautiful music visualizer for YouTube Music that adds audio visualization effects to your listening experience.",
  
  "permissions": [
    "*://music.youtube.com/*",
    "activeTab",
    "storage"
  ],
  
  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["content.js"],
      "css": ["visualizer.css"],
      "run_at": "document_end"
    }
  ],
  
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Music Visualizer",
    "default_icon": "icons/icon.svg"
  },
  
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg", 
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  
  "web_accessible_resources": [
    "visualizer.css"
  ]
}